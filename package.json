{
  "name": "nuevo-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:demos": "node scripts/sync-demos.mjs",
    "sync:sushi": "node scripts/sync-demos.mjs --only sushi1",
    "sync:sushi2": "node scripts/sync-demos.mjs --only sushi2",
    "sync:emberwood": "node scripts/sync-demos.mjs --only emberwood",
    "sushi:install": "npm --prefix demos-src/demo-pagina-sushi1 install",
    "sushi:build": "npm --prefix demos-src/demo-pagina-sushi1 run build",
    "dev": "npm run sync:demos && astro dev",
    "build": "npm run sync:demos && astro check && astro build && node scripts/prefix-base.mjs",
    "check": "astro check",
    "preview": "astro preview"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "@lottiefiles/dotlottie-web": "^0.78.2",
    "@lucide/astro": "^1.64.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.9",
    "astro-og-canvas": "^0.13.0",
    "gsap": "^3.15.0",
    "lucide-astro": "^0.468.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.7.2"
  }
}
