---
import { getImage } from "astro:assets";
import "@/styles/fonts-clinica.css";
import "@/styles/clinica.css";
import { CLINIC } from "@/config/clinic";
import heroImage from "@/assets/hero.jpg";

interface Props {
  title: string;
  description: string;
  keywords?: string;
}

const { title, description, keywords } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = (
  await getImage({
    src: heroImage,
    width: 1200,
    height: 630,
    fit: "cover",
    format: "webp",
    quality: 80,
  })
).src;
const ogImageUrl = new URL(ogImage, Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "VeterinaryCare",
  name: CLINIC.fullName,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Av. Principal 123",
    addressLocality: "Peñaflor",
    addressRegion: "Región Metropolitana",
    addressCountry: "CL",
  },
  telephone: CLINIC.phoneDisplay,
  email: CLINIC.email,
  url: canonical,
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f4ec" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={CLINIC.fullName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:site" content="@VetVida" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
    />
  </head>
  <body class="bg-background text-foreground">
    <div class="cursor-dot" aria-hidden="true"></div>
    <slot />
  </body>
  <script>
    if (matchMedia('(pointer:fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const dot = document.querySelector<HTMLElement>('.cursor-dot');
      window.addEventListener('pointermove', (event) => {
        if (dot) dot.style.transform = `translate3d(${event.clientX}px, ${event.clientY}px, 0)`;
      });
    }
  </script>
</html>
