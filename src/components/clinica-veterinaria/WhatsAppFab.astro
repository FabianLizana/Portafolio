---
import { MessageCircle } from "@lucide/astro";
import { waLink } from "@/config/clinic";
---

<a
  href={waLink()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir por WhatsApp"
  class="fixed bottom-5 right-5 z-40 grid size-14 place-items-center rounded-full bg-whatsapp text-primary-foreground shadow-soft transition hover:scale-105"
>
  <MessageCircle class="size-6" aria-hidden="true" />
</a>
