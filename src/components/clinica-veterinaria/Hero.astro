---
import { CalendarCheck, Clock, Heart, MapPin, PawPrint, ShieldCheck, Users } from "@lucide/astro";
import Btn from "./Btn.astro";
import hero from "@/assets/hero.jpg";

const features = [
  { icon: Heart, label: "Atención personalizada" },
  { icon: Users, label: "Equipo profesional" },
  { icon: ShieldCheck, label: "Cuidado integral" },
];
---

<section id="inicio" class="relative overflow-hidden pt-28 pb-20 md:pt-36">
  <div
    aria-hidden="true"
    class="absolute -top-24 -right-24 size-[28rem] rounded-full bg-sage-soft blur-3xl"
  >
  </div>
  <PawPrint
    aria-hidden="true"
    class="absolute left-[46%] top-32 size-10 rotate-12 text-sage/30"
  />
  <PawPrint aria-hidden="true" class="absolute left-[6%] bottom-16 size-8 -rotate-12 text-beige" />
  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 lg:grid-cols-[1fr_1.1fr]">
    <div class="reveal">
      <p
        class="mb-6 inline-flex items-center gap-2 rounded-full bg-secondary px-4 py-1.5 text-xs font-semibold text-secondary-foreground"
      >
        <MapPin class="size-3.5" aria-hidden="true" /> Peñaflor · Región Metropolitana
      </p>
      <h1 class="text-5xl font-medium leading-[1.05] text-primary md:text-6xl xl:text-7xl">
        Su bienestar es nuestra <em class="text-sage">mayor prioridad</em>
      </h1>
      <p class="mt-6 max-w-lg text-lg text-muted-foreground">
        Cuidamos a quienes llenan tu vida de alegría. Atención veterinaria integral, cercana y
        profesional para tus mejores amigos.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Btn href="#agendar"><CalendarCheck class="size-4" aria-hidden="true" />Agendar una hora</Btn>
        <Btn href="#servicios" variant="outline">Conocer nuestros servicios</Btn>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-3">
        {
          features.map(({ icon: Icon, label }) => (
            <li class="flex items-center gap-2.5 text-sm font-medium text-foreground">
              <span class="grid size-9 place-items-center rounded-full bg-sage-soft text-primary">
                <Icon class="size-4" aria-hidden="true" />
              </span>
              {label}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="reveal relative">
      <div class="overflow-hidden rounded-[2.5rem] shadow-soft">
        <img
          src={hero.src}
          alt="Un golden retriever y un gato atigrado felices en la clínica VetVida"
          width={1600}
          height={1104}
          fetchpriority="high"
          class="aspect-[4/3.4] w-full object-cover"
        />
      </div>
      <div
        class="absolute -bottom-6 left-6 flex items-center gap-3 rounded-2xl bg-card p-4 shadow-soft md:-left-8"
      >
        <span class="grid size-11 place-items-center rounded-xl bg-beige text-primary">
          <Clock class="size-5" aria-hidden="true" />
        </span>
        <div>
          <p class="text-xs text-muted-foreground">Lunes a viernes</p>
          <p class="font-semibold text-primary">09:00 – 19:00</p>
        </div>
      </div>
    </div>
  </div>
</section>
