---
import { PawPrint } from "@lucide/astro";

interface Props {
  light?: boolean;
}

const { light = false } = Astro.props;
---

<a href="#inicio" class="flex items-center gap-2.5" aria-label="VetVida, ir al inicio">
  <span
    class:list={[
      "grid size-10 place-items-center rounded-2xl",
      light ? "bg-sage text-forest" : "bg-primary text-primary-foreground",
    ]}
  >
    <PawPrint class="size-5" aria-hidden="true" />
  </span>
  <span class="leading-none">
    <span
      class:list={[
        "block font-display text-xl font-semibold",
        light ? "text-forest-foreground" : "text-primary",
      ]}
    >
      VetVida
    </span>
    <span
      class:list={[
        "block text-[10px] uppercase tracking-[0.18em]",
        light ? "text-forest-foreground/70" : "text-muted-foreground",
      ]}
    >
      Clínica Veterinaria Integral
    </span>
  </span>
</a>
