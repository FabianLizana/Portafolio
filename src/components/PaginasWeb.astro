---
import { proyectos } from '../data/proyectos';
import TarjetaDemo from './TarjetaDemo.astro';
---

<section class="projects-section" id="paginas-web" aria-labelledby="projects-title">
  <div class="shell">
    <div class="section-heading reveal">
      <p class="eyebrow">Selección / web</p>
      <div>
        <h2 id="projects-title">Páginas web<br /><em>que dejan marca.</em></h2>
        <p>Una colección pequeña, pensada para sentirse distinta desde el primer scroll.</p>
      </div>
    </div>
    <div class="project-grid">
      {proyectos.map((proyecto, index) => <TarjetaDemo proyecto={proyecto} index={index} />)}
    </div>
  </div>
</section>
