---
import { ArrowUpRight, Clock3 } from 'lucide-astro';
import type { Proyecto } from '../data/proyectos';

const { proyecto, index } = Astro.props as { proyecto: Proyecto; index: number };
const isLive = proyecto.status === 'live';
---

<article class:list={['project-card reveal', { 'project-card-featured': proyecto.featured }]} style={`--delay: ${index * 90}ms`}>
  <div class="project-visual">
    <img src={proyecto.image} alt={`Vista previa de ${proyecto.title}`} loading={index === 0 ? 'eager' : 'lazy'} />
    <div class="project-sheen" aria-hidden="true"></div>
    {isLive ? <span class="project-state project-state-live">Demo activa</span> : <span class="project-state"><Clock3 size={14} /> Próximamente</span>}
  </div>
  <div class="project-body">
    <div>
      <p class="project-number">0{index + 1}</p>
      <h3>{proyecto.title}</h3>
      <p class="project-description">{proyecto.description}</p>
    </div>
    <div class="project-footer">
      <ul class="tags" aria-label={`Tecnologías de ${proyecto.title}`}>
        {proyecto.tags.map((tag: string) => <li>{tag}</li>)}
      </ul>
      {isLive ? <a class="project-cta" href={proyecto.href} aria-label={`Ver demo de ${proyecto.title}`}>Ver demo <ArrowUpRight size={17} strokeWidth={2} /></a> : <span class="project-wait">En preparación</span>}
    </div>
  </div>
</article>
