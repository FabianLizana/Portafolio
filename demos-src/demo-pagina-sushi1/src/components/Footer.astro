---
import SushiLogo from './SushiLogo.astro';

interface Props {
  year?: number;
}
const { year = new Date().getFullYear() } = Astro.props;
---

<footer class="bg-bg2 border-t border-white/5 relative z-10">
  <div class="max-w-7xl mx-auto px-5 md:px-8 py-14">
    <div class="grid md:grid-cols-4 gap-10">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5 mb-4">
          <div class="w-10 h-10 rounded-xl bg-bg2 border border-white/10 flex items-center justify-center overflow-hidden">
            <SushiLogo />
          </div>
          <div class="leading-none">
            <div class="font-display font-600 text-lg">Saber De Sabor</div>
            <div class="text-[10px] uppercase tracking-[0.2em] text-neutral-500">Sushi · Peñaflor</div>
          </div>
        </div>
        <p class="text-neutral-400 text-sm max-w-md leading-relaxed mb-5">
          Sushi bar casual en Peñaflor, RM. Rolls frescos, ambiente relajado y planes para uno o para todos. Acá el sushi se disfruta sin pretensiones.
        </p>
        <div class="flex gap-3">
          <a href="https://instagram.com" target="_blank" aria-label="Instagram" class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center text-neutral-400 hover:text-coral hover:border-coral transition-all">
            <i class="fa-brands fa-instagram"></i>
          </a>
          <a href="https://facebook.com" target="_blank" aria-label="Facebook" class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center text-neutral-400 hover:text-coral hover:border-coral transition-all">
            <i class="fa-brands fa-facebook-f"></i>
          </a>
          <a href="https://wa.me/56973341304" target="_blank" aria-label="WhatsApp" class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center text-neutral-400 hover:text-lime2 hover:border-lime2 transition-all">
            <i class="fa-brands fa-whatsapp"></i>
          </a>
          <a href="tel:+56973341304" aria-label="Llamar" class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center text-neutral-400 hover:text-salmon hover:border-salmon transition-all">
            <i class="fa-solid fa-phone"></i>
          </a>
        </div>
      </div>

      <div>
        <h4 class="font-display font-600 text-sm uppercase tracking-wider mb-4 text-neutral-300">Navegación</h4>
        <ul class="space-y-2.5">
          <li><a href="/" class="text-neutral-400 hover:text-coral transition-colors text-sm">Inicio</a></li>
          <li><a href="/menu" class="text-neutral-400 hover:text-coral transition-colors text-sm">Menú</a></li>
          <li><a href="/contacto" class="text-neutral-400 hover:text-coral transition-colors text-sm">Contacto</a></li>
          <li><a href="https://wa.me/56973341304" target="_blank" class="text-neutral-400 hover:text-lime2 transition-colors text-sm">Pedir por WhatsApp</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-display font-600 text-sm uppercase tracking-wider mb-4 text-neutral-300">Contacto</h4>
        <ul class="space-y-2.5 text-sm text-neutral-400">
          <li class="flex items-start gap-2">
            <i class="fa-solid fa-location-dot text-coral mt-1"></i>
            <span>Malloquito 1985, Local B<br />9750000 Peñaflor, RM</span>
          </li>
          <li class="flex items-center gap-2">
            <i class="fa-solid fa-phone text-coral"></i><span>+56 9 7334 1304</span>
          </li>
          <li class="flex items-start gap-2">
            <i class="fa-solid fa-clock text-coral mt-1"></i>
            <span>Lun–Mar, Jue–Dom: 6–11 PM<br />Miércoles: cerrado</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-neutral-500">
      <div>© {year} Saber De Sabor · Felipe Estrada Sushi · Peñaflor, Chile</div>
      <div class="flex items-center gap-2">Hecho con <i class="fa-solid fa-heart text-coral"></i> y mucho roll.</div>
    </div>
  </div>
</footer>
